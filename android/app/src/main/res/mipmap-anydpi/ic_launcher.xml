<?xml version="1.0" encoding="utf-8"?>
<!-- API 24/25 fallback: native rounded silhouette with unchanged logo artwork.
     The inset keeps all bitmap corners inside the rounded background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="48dp" android:height="48dp" />
            <corners android:radius="12dp" />
            <solid android:color="#0A0A20" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <bitmap android:src="@drawable/brand_launcher_legacy" android:gravity="fill" />
    </item>
</layer-list>
