#!/usr/bin/env python3
"""Reject nonconforming messages before a local commit is created."""

import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
raise SystemExit(
    subprocess.call(
        [
            sys.executable,
            str(root / "scripts/check_repository.py"),
            "--subject",
            Path(sys.argv[1]).read_text(encoding="utf-8"),
        ]
    )
)
